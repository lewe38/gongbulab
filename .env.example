# ─── Gemini ────────────────────────────────────────
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèles par usage (swap sans toucher au code)
# Listés via le SDK : pour Gemini 3.x les modèles publics ont le suffixe -preview.
GEMINI_MODEL_EXTRACTION=gemini-3.1-pro-preview
GEMINI_MODEL_VALIDATION=gemini-2.5-flash
GEMINI_MODEL_CHATBOT=gemini-2.5-flash

# ─── Supabase (local dev — valeurs auto par `supabase start`) ─
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── API FastAPI ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Stripe (laisser vide tant que pas configuré) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# ─── Web ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
